# Variables de entorno para el servidor
# Copiar a /opt/integrador/.env y llenar con valores reales

# Base de datos
DATABASE_URL=postgresql://integrador:CAMBIAR_PASSWORD@postgres:5432/integrador
POSTGRES_PASSWORD=CAMBIAR_PASSWORD

# Entorno (staging | production)
ENV=staging

# GCP
GCP_PROJECT_ID=hale-treat-398215
GOOGLE_APPLICATION_CREDENTIALS=/etc/integrador/gcp-key.json

# Autenticacion
GOOGLE_CLIENT_ID=TU_GOOGLE_CLIENT_ID
JWT_SECRET_KEY=GENERAR_CON_python_-c_"import secrets; print(secrets.token_hex(32))"

# Frontend (build args)
VITE_API_BASE_URL=/api
VITE_GOOGLE_CLIENT_ID=TU_GOOGLE_CLIENT_ID
